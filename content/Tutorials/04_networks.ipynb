    "def create_lines(r):\n",
    "    lines = []\n",
    "    for i, neighbor in enumerate(r.neighbors):\n",
    "        lines.append(LineString([r.geometry, gdf.loc[neighbor].geometry]))\n",
    "    return MultiLineString(lines)"
   ]
