   "outputs": [],
   "source": [
    "iso_colors = ox.plot.get_colors(n=len(trip_times), cmap=\"plasma\", start=0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [
    {
     "data": {
