   "source": [
    "# 1. Load scaffold permits and count them per zip code\n",
    "scaffold_df = pd.read_csv(\"./Data/NYC_Scaffold_Permits_20260719.csv\")\n",
    "scaffold_df[\"Zip Code\"] = scaffold_df[\"Zip Code\"].astype(str).str.zfill(5)\n",
    "\n",
    "permits_by_zip = (\n",
    "    scaffold_df.groupby(\"Zip Code\")\n",
    "    .size()\n",
    "    .reset_index(name=\"permit_count\")\n",
    "    .sort_values(\"permit_count\", ascending=False)\n",
    ")\n",
    "\n",
    "print(permits_by_zip.head(10))  # zip codes with the most scaffolding permits\n",
    "\n",
    "# 2. Dissolve census block-group boundaries into zip-code-level polygons\n",
    "boundaries = gpd.read_file(\"./Data/census_nyc_sp.fgb\")\n",
    "boundaries[\"zip_code\"] = boundaries[\"zip_code\"].astype(str).str.zfill(5)\n",
    "zip_boundaries = boundaries.dissolve(by=\"zip_code\", as_index=False)\n",
    "\n",
    "# 3. Join permit counts onto the zip code polygons\n",
    "zip_boundaries = zip_boundaries.merge(\n",
    "    permits_by_zip, left_on=\"zip_code\", right_on=\"Zip Code\", how=\"left\"\n",
    ")\n",
    "zip_boundaries[\"permit_count\"] = zip_boundaries[\"permit_count\"].fillna(0).astype(int)\n",
    "\n",
    "# 4. Save as FlatGeobuf\n",
    "zip_boundaries.to_file(\"scaffold_permits_by_zip.fgb\", driver=\"FlatGeobuf\")\n",
    "\n",
    "# 5. Plot as a gradient choropleth\n",
    "fig, ax = plt.subplots(figsize=(10, 10))\n",
    "zip_boundaries.plot(\n",
    "    column=\"permit_count\",\n",
    "    cmap=\"OrRd\",\n",
    "    linewidth=0.5,\n",
    "    edgecolor=\"grey\",\n",
    "    legend=True,\n",
    "    legend_kwds={\"label\": \"Number of Scaffolding Permits\", \"shrink\": 0.6},\n",
    "    ax=ax,\n",
    ")\n",
    "ax.set_axis_off()\n",
    "ax.set_title(\"Scaffolding Permits by Zip Code\")\n",
    "plt.show()"
   ]
  },
