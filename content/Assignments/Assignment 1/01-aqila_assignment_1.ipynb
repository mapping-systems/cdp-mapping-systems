    "\n",
    "shed_counts = df[\"Community Board\"].value_counts().reset_index()\n",
    "shed_counts.columns = [\"boro_cd\", \"shed_count\"]\n",
    "\n",
    "community_districts = gpd.read_file(\n",
    "    \"https://data.cityofnewyork.us/resource/5crt-au7u.geojson?$limit=100\"\n",
    ").to_crs(epsg=3857)\n",
    "community_districts[\"boro_cd\"] = community_districts[\"boro_cd\"].astype(str).str.strip()\n",
    "\n",
    "community_districts = community_districts.merge(shed_counts, on=\"boro_cd\", how=\"left\")\n",
    "community_districts[\"shed_count\"] = (\n",
    "    community_districts[\"shed_count\"].fillna(0).astype(int)\n",
    ")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 10))\n",
    "community_districts.plot(\n",
    "    column=\"shed_count\",\n",
    "    cmap=\"OrRd\",\n",
    "    linewidth=0.5,\n",
    "    edgecolor=\"grey\",\n",
    "    legend=True,\n",
    "    legend_kwds={\"label\": \"Number of Sidewalk Sheds\", \"shrink\": 0.6},\n",
    "    ax=ax,\n",
    "    zorder=2,\n",
    ")\n",
    "cx.add_basemap(ax, source=cx.providers.CartoDB.Positron, zorder=1)\n",
