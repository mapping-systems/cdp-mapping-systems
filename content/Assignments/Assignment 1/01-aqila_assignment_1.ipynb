   "source": [
    "df = pd.read_csv(\"./Data/Active_Sheds2.csv\")\n",
    "df[\"Community Board\"] = df[\"Community Board\"].astype(str).str.strip()\n",
    "df[\"Borough Name\"] = df[\"Borough Name\"].str.upper().str.strip()\n",
    "\n",
    "district_summary = (\n",
    "    df.groupby([\"Borough Name\", \"Community Board\"])\n",
    "    .agg(shed_count=(\"Age\", \"size\"), avg_age=(\"Age\", \"mean\"))\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "district_summary[\"avg_age\"] = district_summary[\"avg_age\"].round(1)\n",
    "\n",
    "top_10_by_avg_age = district_summary.sort_values(\"avg_age\", ascending=False).head(10)\n",
    "top_10_by_avg_age"
   ]
