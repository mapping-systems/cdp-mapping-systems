   "source": [
    "df = pd.read_csv(\"./Data/Active_Sheds2.csv\")\n",
    "df[\"Community Board\"] = df[\"Community Board\"].astype(str).str.strip()\n",
    "\n",
    "district_summary = (\n",
    "    df.groupby(\"Community Board\")\n",
    "    .agg(shed_count=(\"Age\", \"size\"), avg_age=(\"Age\", \"mean\"))\n",
    "    .reset_index()\n",
    "    .rename(columns={\"Community Board\": \"boro_cd\"})\n",
    "    .sort_values(\"shed_count\", ascending=False)\n",
    ")\n",
    "\n",
    "district_summary[\"avg_age\"] = district_summary[\"avg_age\"].round(1)\n",
    "\n",
    "district_summary"
   ]
